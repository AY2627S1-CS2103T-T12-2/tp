<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" GridPane.columnIndex="0">
      <padding>
        <Insets top="5" right="5" bottom="5" left="15" />
      </padding>
      <HBox spacing="8" alignment="CENTER_LEFT">
        <HBox spacing="0.5" alignment="CENTER_LEFT">
          <Label fx:id="id" styleClass="cell_big_label">
            <minWidth>
              <!-- Ensures that the label text is never truncated -->
              <Region fx:constant="USE_PREF_SIZE" />
            </minWidth>
          </Label>
          <Label fx:id="name" text="\$first" styleClass="cell_big_label" />
        </HBox>
        <Label fx:id="pinned" text="PINNED" styleClass="pinned-badge" visible="false" managed="false" />
        <Label fx:id="balance" text="Balance: 0" styleClass="balance-badge" />
      </HBox>
      <FlowPane fx:id="tags" hgap="5" vgap="3" styleClass="tag-container" />
      <Label fx:id="phone" styleClass="cell_small_label" text="\$phone" />
      <Label fx:id="address" styleClass="cell_small_label" text="\$address" />
      <Label fx:id="email" styleClass="cell_small_label" text="\$email" />
      <VBox fx:id="classes" spacing="3" styleClass="enrolled-class-container" />
      <Label fx:id="subjects" styleClass="cell_small_label" wrapText="true" />
      <Label fx:id="cost" styleClass="cell_small_label" />
      <Label fx:id="lesson" styleClass="cell_small_label" />
    </VBox>
  </GridPane>
</HBox>
