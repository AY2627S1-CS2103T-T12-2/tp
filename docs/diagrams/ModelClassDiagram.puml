@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class UniqueTuitionClassList
Class Person
Class StudentId
Class GuardianContact
Class Enrollment
Class EnrollmentId
Enum PaymentStatus
Class TuitionClass
Class ClassDetails
Enum ClassMode
Class Cost
Class Lesson
Class ClassId
Class Address
Class Email
Class Name
Class Phone
Class Tag

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
AddressBook *--> "1" UniqueTuitionClassList
UniquePersonList --> "~* all" Person
UniqueTuitionClassList --> "~* all" TuitionClass
Person *--> Name
Person *--> Phone
Person *--> Email
Person *--> Address
Person *--> "*" Tag
Person *--> "1" StudentId
Person *--> "1" GuardianContact
Person *--> "*" Enrollment
Person *--> "*" Lesson : legacy records
Enrollment *--> "1" EnrollmentId
Enrollment --> "1" StudentId
Enrollment --> "1" ClassId
Enrollment --> "0..1" TuitionClass : resolved class
Enrollment *--> "1" Cost : agreed rate
Enrollment --> "1" PaymentStatus
TuitionClass *--> ClassId
TuitionClass *--> "1" Cost : default rate
TuitionClass *--> "1" ClassDetails
ClassDetails --> "1" ClassMode
Lesson --> "0..1" ClassId
Lesson --> "1" ClassDetails : legacy / display view

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "~* filtered" Person
@enduml
