@startuml
!include style.puml
skinparam style strictuml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "AddressBook Storage" #F4F6F6{
Class JsonAddressBookStorage
Class JsonSerializableAddressBook
Class JsonAdaptedPerson
Class JsonAdaptedTag
Class JsonAdaptedLesson
Class JsonAdaptedTuitionClass
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonAddressBookStorage

JsonAddressBookStorage ..> JsonSerializableAddressBook
JsonSerializableAddressBook --> "*" JsonAdaptedPerson : persons
JsonSerializableAddressBook --> "*" JsonAdaptedTuitionClass : classes
JsonAdaptedPerson --> "*" JsonAdaptedTag : tags
JsonAdaptedPerson --> "*" JsonAdaptedLesson : lessons

note as EnrollmentStorageNote
  JsonAdaptedLesson stores Enrollment records in "lessons":
  enrollmentId, studentId, classId, cost (agreed rate),
  and paymentStatus. It also reads legacy lesson records.

  JsonAdaptedTuitionClass stores shared class data
  and the default rate (saved as "cost").

  JsonSerializableAddressBook loads shared classes first,
  resolves class IDs, validates identities,
  and migrates legacy lesson records.
end note

JsonAdaptedLesson ..down. EnrollmentStorageNote
' Keep the note below both adapter branches without adding model relationships.
JsonAdaptedTag -[hidden]down-> EnrollmentStorageNote

@enduml
