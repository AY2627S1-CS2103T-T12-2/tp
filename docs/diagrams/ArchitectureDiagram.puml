@startuml
!include <office/Concepts/globe_internet>
!include <office/Concepts/documents>
!include <office/Users/user>
!include style.puml

Package " "<<Rectangle>>{
    Class UI UI_COLOR
    Class Logic LOGIC_COLOR
    Class Storage STORAGE_COLOR
    Class Model MODEL_COLOR
    Class Main #grey
    Class Commons LOGIC_COLOR_T2
}

Class "<$user>" as User MODEL_COLOR_T2
Class "<$documents>\ndata/addressbook.json" as DataFile UI_COLOR_T1
Class "<$documents>\npreferences.json" as PrefsFile UI_COLOR_T1


UI -[#green]> Logic
UI -right[#green]-> Model
Logic -[#blue]-> Storage
Logic -down[#blue]-> Model
Main -[#grey]-> UI
Main -[#grey]-> Logic
Main -[#grey]-> Storage
Main -up[#grey]-> Model
Main -down[hidden]-> Commons

Storage -up[STORAGE_COLOR].> Model
Storage .right[STORAGE_COLOR].> DataFile
Storage .right[STORAGE_COLOR].> PrefsFile
UI .down.> Commons
Logic .down.> Commons
Model .down.> Commons
Storage .down.> Commons
User ..> UI
@enduml
